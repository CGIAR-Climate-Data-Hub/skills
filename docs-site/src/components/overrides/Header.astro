---
import Default from '@astrojs/starlight/components/Header.astro';
---

<div class="cdh-header-stack">
  <div class="cdh-tie-in">
    <a href="https://cgiar-climate-data-hub.github.io/">← Climate Data Hub</a>
  </div>
  <div class="cdh-header-main">
    <Default {...Astro.props}><slot /></Default>
  </div>
</div>

<style>
  /* Starlight's outer <header> is position:fixed with a hard height of
     var(--sl-nav-height). This stack fills that box; the tie-in bar takes a
     fixed slice off the top so Default's header keeps its normal height in
     the remaining space. custom.css adds the same slice to --sl-nav-height
     so the fixed box, sidebar offset, and content padding all stay in sync. */
  .cdh-header-stack {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .cdh-tie-in {
    flex: 0 0 var(--cdh-tie-in-height);
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--cdh-tie-in-bg);
    border-bottom: 1px solid var(--cdh-border);
  }
  .cdh-tie-in a {
    max-width: var(--sl-content-width, 67.5rem);
    margin-inline: auto;
    padding-inline: var(--space-4);
    font-family: var(--mono);
    font-size: var(--font-size-2);
    letter-spacing: 0.02em;
    color: var(--cdh-tie-in-fg);
    text-decoration: none;
  }
  .cdh-tie-in a:hover {
    color: var(--cdh-link);
    text-decoration: underline;
  }

  .cdh-header-main {
    flex: 1 1 auto;
    min-height: 0;
  }
</style>
