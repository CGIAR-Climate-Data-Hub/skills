---
import Default from '@astrojs/starlight/components/Footer.astro';

const year = new Date().getFullYear();
---

<Default {...Astro.props}><slot /></Default>

<footer class="cdh-band">
  <div class="cdh-band-inner">
    <span>
      Part of the <a href="https://cgiar-climate-data-hub.github.io/">Climate Data Hub</a>
    </span>
    <a href="https://github.com/CGIAR-Climate-Data-Hub/skills">GitHub</a>
    <span class="cdh-band-license">CC BY 4.0 · CGIAR {year}</span>
  </div>
</footer>

<style>
  .cdh-band {
    background: var(--cdh-brand-primary);
    color: var(--cdh-brand-accent);
    margin-top: var(--space-8);
  }
  .cdh-band-inner {
    max-width: var(--sl-content-width, 67.5rem);
    margin-inline: auto;
    padding: var(--space-4);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-5);
    font-family: var(--sans);
    font-size: var(--font-size-3);
  }
  .cdh-band-inner a {
    color: var(--cdh-brand-accent);
    text-decoration: none;
  }
  .cdh-band-inner a:hover {
    text-decoration: underline;
  }
  .cdh-band-inner span {
    color: color-mix(in srgb, var(--cdh-brand-accent) 75%, transparent);
  }
  .cdh-band-license {
    margin-left: auto;
  }
</style>
